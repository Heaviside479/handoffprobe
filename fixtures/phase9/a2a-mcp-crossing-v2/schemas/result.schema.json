{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://minorityprophet.org/schema/a2a-mcp-crossing-result-v2.json",
  "type":"object","additionalProperties":false,
  "required":["profile","grade","corpus_sha256","implementation","results"],
  "properties":{
    "profile":{"const":"https://minorityprophet.org/conformance/a2a-mcp-crossing/v2"},
    "grade":{"enum":["reference_fixture","transport_real","implementation_independent","operator_independent"]},
    "corpus_sha256":{"pattern":"^[0-9a-f]{64}$"},
    "implementation":{"type":"object","additionalProperties":false,"required":["a2a","mcp","verifier","operator"],"properties":{"a2a":{"type":"string","minLength":1},"mcp":{"type":"string","minLength":1},"verifier":{"type":"string","minLength":1},"operator":{"type":"string","minLength":1}}},
    "results":{"type":"array","minItems":28,"maxItems":28,"prefixItems":[
      {"$ref":"#/$defs/valid_crossing"},{"$ref":"#/$defs/existing_task_valid"},{"$ref":"#/$defs/existing_task_stage_evidence_present"},{"$ref":"#/$defs/existing_task_previous_stage_present"},{"$ref":"#/$defs/caller_swap"},{"$ref":"#/$defs/message_swap"},{"$ref":"#/$defs/task_swap"},{"$ref":"#/$defs/context_swap"},{"$ref":"#/$defs/requester_omitted_both"},{"$ref":"#/$defs/message_omitted_both"},{"$ref":"#/$defs/task_omitted_both"},{"$ref":"#/$defs/context_omitted_both"},{"$ref":"#/$defs/audience_swap"},{"$ref":"#/$defs/tool_swap"},{"$ref":"#/$defs/arguments_swap"},{"$ref":"#/$defs/nonce_substitution"},{"$ref":"#/$defs/authority_id_swap"},{"$ref":"#/$defs/authority_digest_swap"},{"$ref":"#/$defs/not_yet_valid"},{"$ref":"#/$defs/expired"},{"$ref":"#/$defs/status_ref_swap"},{"$ref":"#/$defs/revoked"},{"$ref":"#/$defs/stale_status"},{"$ref":"#/$defs/replay"},{"$ref":"#/$defs/initial_authority_digest_swap"},{"$ref":"#/$defs/previous_stage_digest_swap"},{"$ref":"#/$defs/stage_message_swap"},{"$ref":"#/$defs/stage_evidence_omitted"}
    ],"items":false}
  },
  "$defs":{
    "attempt":{"type":"object","additionalProperties":false,"required":["attempt","outcome","reason","effect_before","effect_after","effect_delta"],"properties":{"attempt":{"type":"integer","minimum":1},"outcome":{"enum":["succeed","reject","non_comparable"]},"reason":{"enum":["accepted","input_contract_invalid","profile_mismatch","authority_digest_mismatch","authority_id_mismatch","task_binding_unresolved","stage_evidence_missing","stage_evidence_unexpected","stage_mode_invalid","initial_authority_digest_mismatch","initial_authority_id_mismatch","initial_stage_invalid","stage_link_mismatch","stage_message_mismatch","stage_reissue_mismatch","caller_mismatch","message_mismatch","task_mismatch","context_mismatch","audience_mismatch","action_digest_mismatch","not_yet_valid","expired","status_reference_mismatch","status_stale","authority_not_current","nonce_replay","adapter_non_comparable"]},"effect_before":{"type":"integer","minimum":0},"effect_after":{"type":"integer","minimum":0},"effect_delta":{"type":"integer","minimum":0,"maximum":1}}},
    "lane":{"type":"object","additionalProperties":false,"required":["measurement","attempts"],"properties":{"measurement":{"enum":["not_measured","fixture_observed","externally_observed"]},"attempts":{"type":"array","items":{"$ref":"#/$defs/attempt"}}},"allOf":[{"if":{"properties":{"measurement":{"const":"not_measured"}},"required":["measurement"]},"then":{"properties":{"attempts":{"maxItems":0}}}},{"if":{"properties":{"measurement":{"enum":["fixture_observed","externally_observed"]}},"required":["measurement"]},"then":{"properties":{"attempts":{"minItems":1}}}}]},
    "caseResult":{"type":"object","additionalProperties":false,"required":["case","native","bound"],"properties":{"case":{"type":"string"},"native":{"$ref":"#/$defs/lane"},"bound":{"$ref":"#/$defs/lane"}}},
