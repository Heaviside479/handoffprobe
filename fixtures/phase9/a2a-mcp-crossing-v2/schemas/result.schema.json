    "stale_status":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"stale_status"}}}]},
    "replay":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"replay"}}}]},
    "initial_authority_digest_swap":{"allOf":[{"$ref":"#/$defs/caseResult"},{"properties":{"case":{"const":"initial_authority_digest_swap"}}}]},
