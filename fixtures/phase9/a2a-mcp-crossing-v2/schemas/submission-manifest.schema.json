{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://minorityprophet.org/schema/a2a-mcp-crossing-submission-v2.json",
  "type":"object",
  "additionalProperties":false,
  "required":["profile","artifacts"],
  "properties":{
    "profile":{"const":"https://minorityprophet.org/conformance/a2a-mcp-crossing/v2"},
    "artifacts":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "corpus_manifest","result","raw_log","adapter_config","implementation",
        "effect_recorder","replay_store","caller_source","audience_source",
        "status_source_policy","authority_authentication","grade_evidence"
      ],
      "properties":{
        "corpus_manifest":{"$ref":"#/$defs/artifact"},
        "result":{"$ref":"#/$defs/artifact"},
        "raw_log":{"$ref":"#/$defs/artifact"},
        "adapter_config":{"$ref":"#/$defs/artifact"},
        "implementation":{"$ref":"#/$defs/artifact"},
        "effect_recorder":{"$ref":"#/$defs/artifact"},
        "replay_store":{"$ref":"#/$defs/artifact"},
        "caller_source":{"$ref":"#/$defs/artifact"},
        "audience_source":{"$ref":"#/$defs/artifact"},
        "status_source_policy":{"$ref":"#/$defs/artifact"},
        "authority_authentication":{"$ref":"#/$defs/artifact"},
        "grade_evidence":{"$ref":"#/$defs/artifact"}
      }
    }
  },
  "$defs":{
    "artifact":{
      "type":"object",
      "additionalProperties":false,
      "required":["path","sha256"],
      "properties":{
        "path":{"type":"string","minLength":1},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    }
  }
}
