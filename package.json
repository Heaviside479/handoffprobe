{
  "name": "handoffprobe",
  "version": "0.0.0",
  "description": "Adversarial security testing for AI agent handoffs",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "handoffprobe": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" package.json tsconfig.json tsconfig.build.json eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" package.json tsconfig.json tsconfig.build.json eslint.config.mjs .prettierrc.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "package:check": "npm pack --dry-run",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
